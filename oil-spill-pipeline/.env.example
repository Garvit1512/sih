# Mapbox GL JS access token (required for the map — see CLAUDE.md §4/§32).
# Prefixed with NEXT_PUBLIC_ because react-map-gl/mapbox renders client-side.
# Get a token at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Base URL of the backend API (see CLAUDE.md §43).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Request timeout for API calls, in seconds (see CLAUDE.md §43).
NEXT_PUBLIC_API_TIMEOUT_SECONDS=30
