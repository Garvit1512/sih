# Backend configuration. Copy this file to `.env` in this same directory:
#
#     cd backend
#     cp .env.example .env
#
# app/core/config.py reads `.env` relative to the process working directory,
# and the documented launch is `cd backend && uvicorn app.main:app --reload`,
# so the file belongs here — not at the repo root.
#
# There are NO third-party API keys in this project. Nothing here is secret.

ENVIRONMENT=development
DEBUG=true
API_TIMEOUT_SECONDS=30

# MUST match the origin the frontend is served from, or the browser blocks
# every request with a CORS error that looks like "could not reach the
# backend". The Next.js frontend runs on :3000 (the :5173 default in
# config.py is Vite's port, from before this frontend existed).
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Stage B triage thresholds (km) — placeholder values, not yet team-approved.
TRIAGE_PLATFORM_RADIUS_KM=5.0
TRIAGE_PIPELINE_RADIUS_KM=2.0

# Upstream stage integration mode: mock | real
STAGE_A_MODE=mock
STAGE_C_MODE=mock
STAGE_D_MODE=mock
