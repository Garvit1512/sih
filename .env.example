# Backend
ENVIRONMENT=development
DEBUG=true
API_TIMEOUT_SECONDS=30
# Must match the frontend origin. The Next.js app runs on :3000.
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Stage B triage thresholds (km) - PLACEHOLDER VALUES, not yet team-approved
TRIAGE_PLATFORM_RADIUS_KM=5.0
TRIAGE_PIPELINE_RADIUS_KM=2.0

# Upstream stage integration mode: mock | real
STAGE_A_MODE=mock
STAGE_C_MODE=mock
STAGE_D_MODE=mock

# Stage C real-engine parameters (idealized synthetic current field, not real
# oceanographic data -- see docs/stage-c-d-integration-plan.md)
DRIFT_HINDCAST_HOURS=6.0
DRIFT_FORECAST_HOURS=24.0
DRIFT_STEP_MINUTES=30.0
DRIFT_ORIGIN_TIME_WINDOW_PAD_HOURS=1.0
DRIFT_ORIGIN_TOLERANCE_KM_PER_HOUR=0.8

# Stage D real-engine parameters (synthetic AIS scenario generation and scoring).
# Confidence thresholds are PLACEHOLDER VALUES, not yet team-approved (see
# docs/decisions.md #12), same status as the Stage B radii above.
ATTRIBUTION_CANDIDATE_SEARCH_RADIUS_KM=60.0
ATTRIBUTION_TIME_WINDOW_PAD_HOURS=3.0
ATTRIBUTION_BACKGROUND_VESSEL_COUNT=4
ATTRIBUTION_PROXIMITY_WEIGHT=0.5
ATTRIBUTION_TRAJECTORY_WEIGHT=0.5
ATTRIBUTION_HIGH_CONFIDENCE_THRESHOLD=70.0
ATTRIBUTION_MEDIUM_CONFIDENCE_THRESHOLD=40.0

# Frontend
MAPBOX_TOKEN=
API_BASE_URL=http://localhost:8000
MAP_DEFAULT_ZOOM=2
MAP_DEFAULT_CENTER_LAT=15.0
MAP_DEFAULT_CENTER_LON=67.0
